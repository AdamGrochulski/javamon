# Skopiuj do .env (ignorowanego przez gita) i uzupełnij.
# Na devie wszystko ma sensowne wartości domyślne — .env jest opcjonalny.

# --- Postgres ---
POSTGRES_DB=javamon
POSTGRES_USER=javamon
POSTGRES_PASSWORD=javamon-dev
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Aplikacja ---
SERVER_PORT=8080

# Profil. Aplikacja NIE ma profilu domyślnego — `mvn spring-boot:run` włącza
# `dev` sam (konfiguracja pluginu w app/pom.xml), a uruchomienie jara wymaga
# ustawienia tej zmiennej jawnie.
SPRING_PROFILES_ACTIVE=dev

# Klucz do podpisywania JWT. Wyłącznie profil dev ma wartość zastępczą.
# Bez profilu dev brak tej zmiennej = aplikacja nie wstaje (i tak ma być:
# znany klucz podpisu = możliwość wystawienia tokenu na dowolne konto).
# Wygenerowanie: openssl rand -base64 48
JWT_SECRET=
