# Skopiuj do .env (ignorowanego przez gita) i uzupełnij.
# Na devie wszystko ma sensowne wartości domyślne — .env jest opcjonalny.

# --- Postgres ---
POSTGRES_DB=javamon
POSTGRES_USER=javamon
POSTGRES_PASSWORD=javamon-dev
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Aplikacja ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Klucz do podpisywania JWT. Profil dev ma wartość zastępczą,
# profil prod NIE — tam ta zmienna jest wymagana.
# Wygenerowanie: openssl rand -base64 48
JWT_SECRET=
